{
  "name": "LaborLine",
  "table": "tag_labor",
  "description": "Hours worked by one employee on a tag.",
  "primaryKey": [
    "id"
  ],
  "fields": [
    {
      "name": "id",
      "type": "id",
      "nullable": false,
      "description": "Surrogate key"
    },
    {
      "name": "tag_id",
      "type": "id",
      "nullable": false,
      "description": "Owning tag"
    },
    {
      "name": "position",
      "type": "integer",
      "nullable": false,
      "description": "Order within the tag",
      "default": 0
    },
    {
      "name": "employee_id",
      "type": "string",
      "length": 50,
      "nullable": false,
      "description": "Employee id from eMachine",
      "default": ""
    },
    {
      "name": "employee_name",
      "type": "string",
      "length": 255,
      "nullable": false,
      "description": "Employee display name",
      "default": ""
    },
    {
      "name": "trade",
      "type": "string",
      "length": 100,
      "nullable": false,
      "description": "Trade (from tag_labor_rates)",
      "default": ""
    },
    {
      "name": "regular_hours",
      "type": "decimal",
      "precision": 8,
      "scale": 2,
      "nullable": false,
      "description": "Regular hours",
      "default": 0
    },
    {
      "name": "overtime_hours",
      "type": "decimal",
      "precision": 8,
      "scale": 2,
      "nullable": false,
      "description": "Overtime hours",
      "default": 0
    },
    {
      "name": "double_hours",
      "type": "decimal",
      "precision": 8,
      "scale": 2,
      "nullable": false,
      "description": "Double-time hours",
      "default": 0
    }
  ]
}
