{
  "name": "TagStatus",
  "table": "tag_statuses",
  "description": "Lifecycle states a tag can be in (reference data).",
  "primaryKey": [
    "code"
  ],
  "fields": [
    {
      "name": "code",
      "type": "string",
      "length": 20,
      "nullable": false,
      "description": "Status code stored on tags.status"
    },
    {
      "name": "label",
      "type": "string",
      "length": 50,
      "nullable": false,
      "description": "Display label"
    },
    {
      "name": "editable",
      "type": "boolean",
      "nullable": false,
      "description": "Whether tags in this status can be edited",
      "default": false
    },
    {
      "name": "sort_order",
      "type": "integer",
      "nullable": false,
      "description": "Display order",
      "default": 0
    }
  ]
}
