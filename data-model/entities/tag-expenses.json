{
  "name": "ExpenseLine",
  "table": "tag_expenses",
  "description": "Other charges (parking, dump fees \u2026) on a tag.",
  "primaryKey": [
    "id"
  ],
  "fields": [
    {
      "name": "id",
      "type": "id",
      "nullable": false,
      "description": "Surrogate key"
    },
    {
      "name": "tag_id",
      "type": "id",
      "nullable": false,
      "description": "Owning tag"
    },
    {
      "name": "position",
      "type": "integer",
      "nullable": false,
      "description": "Order within the tag",
      "default": 0
    },
    {
      "name": "description",
      "type": "string",
      "length": 255,
      "nullable": false,
      "description": "Expense type (from expenses_master or free text)",
      "default": ""
    },
    {
      "name": "amount",
      "type": "decimal",
      "precision": 12,
      "scale": 2,
      "nullable": false,
      "description": "Amount in USD",
      "default": 0
    }
  ]
}
