{
  "name": "Attachment",
  "table": "tag_attachments",
  "description": "Photo or document attached to a tag; bytes live in file storage.",
  "primaryKey": [
    "id"
  ],
  "fields": [
    {
      "name": "id",
      "type": "id",
      "nullable": false,
      "description": "Surrogate key"
    },
    {
      "name": "tag_id",
      "type": "id",
      "nullable": false,
      "description": "Owning tag"
    },
    {
      "name": "file_name",
      "type": "string",
      "length": 255,
      "nullable": false,
      "description": "Original file name"
    },
    {
      "name": "content_type",
      "type": "string",
      "length": 100,
      "nullable": false,
      "description": "MIME type"
    },
    {
      "name": "size_bytes",
      "type": "integer",
      "nullable": false,
      "description": "Size in bytes"
    },
    {
      "name": "storage_key",
      "type": "string",
      "length": 100,
      "nullable": false,
      "description": "Key of the stored file"
    },
    {
      "name": "uploaded_by",
      "type": "string",
      "length": 100,
      "nullable": false,
      "description": "Uploader",
      "default": ""
    },
    {
      "name": "created_at",
      "type": "timestamp",
      "nullable": false,
      "description": "Upload time (UTC)"
    }
  ]
}
