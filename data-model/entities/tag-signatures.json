{
  "name": "Signature",
  "table": "tag_signatures",
  "description": "The customer approver's signature or signature request (one per tag).",
  "primaryKey": [
    "tag_id"
  ],
  "fields": [
    {
      "name": "tag_id",
      "type": "id",
      "nullable": false,
      "description": "Owning tag"
    },
    {
      "name": "approver",
      "type": "string",
      "length": 255,
      "nullable": false,
      "description": "Approver name",
      "default": ""
    },
    {
      "name": "mode",
      "type": "string",
      "length": 20,
      "nullable": false,
      "description": "in-person or send",
      "default": "in-person"
    },
    {
      "name": "email",
      "type": "string",
      "length": 255,
      "nullable": false,
      "description": "Where the request was sent",
      "default": ""
    },
    {
      "name": "image_png",
      "type": "text",
      "nullable": false,
      "description": "Signature as a PNG data URL (in-person)",
      "default": ""
    },
    {
      "name": "signed_at",
      "type": "timestamp",
      "nullable": true,
      "description": "Signing time (UTC)"
    }
  ]
}
