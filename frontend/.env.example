# Copy to .env.local (git-ignored).

# Where the browser sends eMachine requests. Empty = same origin (/datamodel/...),
# forwarded by the Vite dev server or nginx. Set a full URL to call eMachine
# directly (it must then allow this site's origin via CORS).
VITE_EMACHINE_BASE_URL=

# Target of the /datamodel proxy for `npm run dev` / `npm run preview`.
EMACHINE_PROXY_TARGET=https://emachine.instantar.io

# Saving to eMachine is OFF unless this is true. While off, Save logs the
# requests it would send to the browser console and sends nothing.
VITE_EMACHINE_WRITES=false

# Optional: a token built into the app for every user. Anything in VITE_* is
# visible to anyone who loads the site. Leave empty to have each user paste
# their own token on the sign-in screen.
VITE_EMACHINE_TOKEN=
