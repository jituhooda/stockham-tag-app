{
  "name": "stockham-tags",
  "displayName": "Stockham Tags",
  "description": "Change-order tag management for Stockham Construction (web, tablet, mobile).",
  "version": "1.0.0",
  "owner": "Stockham Construction",
  "license": "Proprietary (see LICENSE)",
  "components": {
    "frontend": {
      "path": "frontend",
      "language": "JavaScript (JSX)",
      "framework": "React 19 + Vite",
      "entry": "frontend/main.jsx",
      "port": 8080,
      "devPort": 5173
    },
    "backend": {
      "path": "backend",
      "language": "Python 3.11+",
      "framework": "FastAPI + SQLAlchemy Core",
      "entry": "apexapp.main:app",
      "port": 8000
    },
    "database": {
      "supported": [
        "sqlite",
        "postgres"
      ],
      "default": "sqlite",
      "migrations": "database/migrations"
    },
    "integrations": [
      {
        "name": "eMachine",
        "type": "http",
        "direction": "read",
        "config": "config/integrations.config.json"
      }
    ]
  },
  "contracts": {
    "openapi": "api/openapi.yaml",
    "dataModel": "data-model/model.json",
    "configSchema": "config/config.schema.json"
  },
  "commands": {
    "setup": "scripts/setup.sh",
    "start": "scripts/start.sh",
    "stop": "scripts/stop.sh",
    "test": "scripts/validate-export.sh --tests",
    "health": "scripts/health-check.sh",
    "migrate": "scripts/db-migrate.sh"
  },
  "structure": {
    "required": [
      "README.md",
      "LICENSE",
      "CHANGELOG.md",
      "VERSION",
      "manifest.json",
      ".gitignore",
      ".dockerignore",
      ".editorconfig",
      ".apexstudio/project.json",
      ".apexstudio/generation-manifest.json",
      ".apexstudio/export-manifest.json",
      ".apexstudio/artifact-hashes.json",
      ".apexstudio/compatibility.json",
      "frontend/App.jsx",
      "frontend/components/ui.jsx",
      "frontend/components/icons.jsx",
      "frontend/pages",
      "frontend/layouts",
      "frontend/hooks",
      "frontend/services",
      "frontend/state",
      "frontend/routes",
      "frontend/lib/apexApi.js",
