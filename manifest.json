{
  "name": "stockham-tags",
  "displayName": "Stockham Tags",
  "description": "Change-order tag management for Stockham Construction (web, tablet, mobile). A frontend-only app that reads and writes eMachine directly.",
  "version": "1.0.0",
  "owner": "Stockham Construction",
  "license": "Proprietary (see LICENSE)",
  "components": {
    "frontend": {
      "path": "frontend",
      "language": "JavaScript (JSX)",
      "framework": "React 19 + Vite",
      "entry": "frontend/main.jsx",
      "port": 8080,
      "devPort": 5173
    },
    "integrations": [
      {
        "name": "eMachine",
        "type": "http",
        "direction": "read/write",
        "config": "config/integrations.config.json",
        "contract": "api/openapi.yaml"
      }
    ]
  },
  "contracts": {
    "openapi": "api/openapi.yaml",
    "configSchema": "config/config.schema.json"
  },
  "commands": {
    "setup": "scripts/setup.sh",
    "start": "scripts/start.sh",
    "stop": "scripts/stop.sh",
    "test": "scripts/validate-export.sh --tests",
    "health": "scripts/health-check.sh"
  },
  "structure": {
    "required": [
      "README.md",
      "LICENSE",
      "CHANGELOG.md",
      "VERSION",
      "manifest.json",
      ".gitignore",
      ".dockerignore",
      ".editorconfig",
      ".env.example",
      ".apexstudio/project.json",
      ".apexstudio/generation-manifest.json",
      ".apexstudio/export-manifest.json",
      ".apexstudio/artifact-hashes.json",
      ".apexstudio/compatibility.json",
      "frontend/App.jsx",
      "frontend/main.jsx",
      "frontend/components/ui.jsx",
      "frontend/components/icons.jsx",
      "frontend/pages",
      "frontend/layouts",
      "frontend/hooks",
      "frontend/services",
      "frontend/state",
      "frontend/routes",
      "frontend/lib/apexApi.js",
      "frontend/lib/apexConfig.js",
      "frontend/lib/apexHttp.js",
      "frontend/assets",
      "frontend/public",
      "frontend/tests",
      "frontend/package.json",
      "frontend/package-lock.json",
      "frontend/vite.config.js",
      "frontend/index.html",
      "frontend/.env.example",
      "frontend/Dockerfile",
      "config/app.config.json",
      "config/branding.config.json",
      "config/features.config.json",
      "config/integrations.config.json",
      "config/config.schema.json",
      "api/openapi.yaml",
      "tests/e2e",
      "infrastructure/docker",
      "infrastructure/nginx",
      "scripts/setup.sh",
      "scripts/start.sh",
      "scripts/stop.sh",
      "scripts/health-check.sh",
      "scripts/validate-export.sh",
      "docs/architecture.md",
      "docs/code-generation.md",
      "docs/api.md",
      "docs/deployment.md",
      "docs/configuration.md",
      "docs/security.md",
      "docs/troubleshooting.md",
      "docker-compose.yml",
      "docker-compose.dev.yml",
      ".github/workflows/ci.yml"
    ]
  }
}
