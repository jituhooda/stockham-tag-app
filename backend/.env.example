# Backend settings. Values here override the JSON files in ../config.
APP_ENV=development

# sqlite:///absolute/or/relative/path.db  or  postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=sqlite:///./data/stockham-tags.db
RUN_MIGRATIONS=true

# eMachine data-model API. The token stays on the server; the browser never sees it.
EMACHINE_MODE=live            # live | fixtures (offline sample data)
EMACHINE_API_TOKEN=
# EMACHINE_BASE_URL=https://emachine.instantar.io/datamodel/api/model_query
# EMACHINE_CACHE_TTL=300

# Auth: none (single local user with defaultRole) or token (Bearer tokens below).
AUTH_MODE=none
# AUTH_TOKENS={"a-long-random-token":{"name":"Sean Hubert","role":"approver"}}

ATTACHMENTS_DIR=./data/attachments
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
LOG_FORMAT=text               # text | json
# ISSUES_QUERY=select Id, Description from issues
# STATIC_DIR=../frontend/dist # serve the built web app from this process
