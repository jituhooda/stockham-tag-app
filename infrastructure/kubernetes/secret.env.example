# Copy to secret.env (git-ignored), fill in, then:
#   kubectl -n stockham-tags create secret generic stockham-tags --from-env-file=secret.env
DATABASE_URL=postgresql+psycopg://stockham:CHANGE_ME@postgres.example.internal:5432/stockham_tags
EMACHINE_API_TOKEN=
AUTH_TOKENS={"CHANGE_ME_long_random_token":{"name":"Admin","role":"admin"}}
