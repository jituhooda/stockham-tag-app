{
  "title": "Stockham Tags",
  "uid": "stockham-tags",
  "schemaVersion": 39,
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "type": "timeseries", "title": "Requests per second by status",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (status) (rate(stockham_http_requests_total[5m]))", "legendFormat": "{{status}}" }]
    },
    {
      "type": "timeseries", "title": "Average response time (s)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (route) (rate(stockham_http_request_duration_seconds_sum[5m])) / sum by (route) (rate(stockham_http_request_duration_seconds_count[5m]))", "legendFormat": "{{route}}" }]
    },
    {
      "type": "stat", "title": "Tags submitted (24h)",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(increase(stockham_http_requests_total{route=\"/api/v1/tags/{tag_id}/submit\",status=\"200\"}[24h]))" }]
    },
    {
      "type": "stat", "title": "eMachine errors (24h)",
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(increase(stockham_http_requests_total{status=\"502\"}[24h]))" }]
    }
  ]
}
