# Copy to .env (git-ignored). Used by docker compose and scripts/*.sh.
APP_VERSION=1.0.0
WEB_PORT=8080

# --- eMachine (reference data) --------------------------------------------
# live = call eMachine; fixtures = offline sample data (database/fixtures)
EMACHINE_MODE=live
EMACHINE_API_TOKEN=

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL unset for SQLite in the data volume. The prod overlay
# builds a PostgreSQL URL from POSTGRES_PASSWORD.
# DATABASE_URL=sqlite:////data/stockham-tags.db
POSTGRES_PASSWORD=

# --- Access -----------------------------------------------------------------
# none: everyone is admin (development / behind an authenticating proxy)
# token: users sign in with an access token from AUTH_TOKENS
AUTH_MODE=none
# AUTH_TOKENS={"a-long-random-token":{"name":"Sean Hubert","role":"approver"}}
CORS_ORIGINS=http://localhost:8080
