{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockham.example/tags/config.schema.json",
  "title": "Stockham Tags configuration",
  "description": "Schemas for each file in config/. The web app bundles these at build time; VITE_* variables override some values (see docs/configuration.md).",
  "definitions": {
    "app": {
      "type": "object",
      "required": [
        "name",
        "version",
        "defaultDivisions"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "shortName": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+"
        },
        "defaultDivisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "editableStatuses": {
          "type": "array",
          "items": {
            "enum": [
              "Draft",
              "Submitted",
              "Signed",
              "Approved",
              "Rejected"
            ]
          }
        },
        "timezone": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "branding": {
      "type": "object",
      "required": [
        "companyName",
        "appTitle",
        "colors"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "companyName": {
          "type": "string"
        },
        "appTitle": {
          "type": "string"
        },
        "appSubtitle": {
          "type": "string"
        },
        "colors": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        }
      },
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "description": "Switches for parts of the app whose eMachine save APIs are not wired yet. Turn one on only after its API is implemented.",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "premiumTime": {
          "type": "boolean"
        },
        "sendForSignature": {
          "type": "boolean"
        },
        "submit": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "integrations": {
      "type": "object",
      "required": [
        "emachine"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "submit": {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "comment": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "timeoutSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "uploads": {
          "type": "object",
          "required": [
            "url",
            "providerName",
            "customerName",
            "pathTemplate",
            "appId"
          ],
          "properties": {
            "comment": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "pattern": "^/"
            },
            "deleteUrl": {
              "type": "string",
              "pattern": "^/"
            },
            "providerName": {
              "type": "string"
            },
            "customerName": {
              "type": "string"
            },
            "pathTemplate": {
              "type": "string",
              "pattern": "\\{user\\}"
            },
            "appId": {
              "type": "string"
            },
            "maxFileMb": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "timeoutSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "image": {
              "type": "object",
              "properties": {
                "maxPixels": {
                  "type": "integer",
                  "minimum": 256
                },
                "quality": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "forma": {
          "type": "object",
          "required": [
            "apiBase",
            "tokenUrl",
            "accountId",
            "projectsPath",
            "jobFilter"
          ],
          "properties": {
            "comment": {
              "type": "string"
            },
            "apiBase": {
              "type": "string",
              "format": "uri"
            },
            "tokenUrl": {
              "type": "string",
              "format": "uri",
              "description": "Returns { access_token, expires_at } (epoch seconds); no login needed"
            },
            "accountId": {
              "type": "string"
            },
            "projectsPath": {
              "type": "string",
              "pattern": "\\{accountId\\}"
            },
            "jobFilter": {
              "type": "string"
            },
            "issuesPath": {
              "type": "string",
              "pattern": "\\{projectId\\}"
            },
            "issueStatuses": {
              "type": "string"
            },
            "issuePageSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "additionalProperties": false
        },
        "emachine": {
          "type": "object",
          "required": [
            "baseUrl",
            "queryPath",
            "tablePath",
            "queries",
            "writes"
          ],
          "properties": {
            "baseUrl": {
              "type": "string",
              "format": "uri"
            },
            "queryPath": {
              "type": "string",
              "pattern": "^/"
            },
            "tablePath": {
              "type": "string",
              "pattern": "\\{table\\}"
            },
            "timeoutSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "queries": {
              "type": "object",
              "required": [
                "tags",
                "tag",
                "tagLabor",
                "tagMaterials",
                "tagEquipment",
                "tagExpenses",
                "employees",
                "trades",
                "materials",
                "equipment",
                "expenses",
                "division",
                "jobs"
              ],
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "writes": {
              "type": "object",
              "properties": {
                "comment": {
                  "type": "string"
                }
              },
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
