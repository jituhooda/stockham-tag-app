# Production: Postgres, token auth, JSON logs. Keep real values in a secret store.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://stockham:change-me@postgres:5432/stockham_tags
EMACHINE_MODE=live
EMACHINE_API_TOKEN=
AUTH_MODE=token
AUTH_TOKENS={}
LOG_LEVEL=INFO
LOG_FORMAT=json
CORS_ORIGINS=https://tags.example.com
