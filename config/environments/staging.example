# Staging: Postgres, token auth, JSON logs.
APP_ENV=staging
DATABASE_URL=postgresql+psycopg://stockham:change-me@postgres:5432/stockham_tags
EMACHINE_MODE=live
EMACHINE_API_TOKEN=
AUTH_MODE=token
# JSON map of access token -> {"name", "role"}; roles: viewer, editor, approver, admin
AUTH_TOKENS={"replace-with-a-long-random-token":{"name":"Staging Admin","role":"admin"}}
LOG_LEVEL=INFO
LOG_FORMAT=json
CORS_ORIGINS=https://tags-staging.example.com
